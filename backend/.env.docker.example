# Template for .env.docker (gitignored, never committed). Copy, chmod 600, fill from the secret store.
# Read by compose for interpolation only (COMPOSE_ENV_FILES=.env.docker); each value reaches only the services that use it.
# Leave values blank here. Blank required values make every compose command fail before any container starts.
# A value containing $ must be single-quoted, or compose interpolates it.

# Secrets

# keeper only. 0x + 64 hex. Must derive to roles.keeper in deployments/143.json.
KEEPER_KEY=
# relay only. 0x + 64 hex, must differ from KEEPER_KEY. Leave blank while SPONSOR_ENABLED=false.
RELAY_KEY=
# relay and keeper (same value). 32 to 256 chars of [A-Za-z0-9_-], generated with openssl rand -hex 32.
RELAY_INTERNAL_TOKEN=
# jobs only. Envio HyperSync API token.
ENVIO_API_TOKEN=
# relay, keeper, jobs. Comma-separated https URLs, at most 5; the first must be the private endpoint near this host.
MONAD_HTTP_URLS=
# relay and keeper. One wss URL (monadNewHeads).
MONAD_WS_URL=

# Operator values (not secret)

# relay. https origin of the PWA, no path, no trailing slash.
APP_ORIGIN=
# Optional. Image tag to run (default canary); set to a previous tag to roll back.
GAPLESS_IMAGE_TAG=
