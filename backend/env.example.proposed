# Proposed replacement for backend/.env.example (the protect-files hook blocks agent writes to
# any path containing ".env"). Review, then: mv env.example.proposed .env.example
#
# Gapless backend: one package, three processes (relay, keeper, jobs), each with its own schema
# in src/lib/env.ts. Copy the block for the process you run. Blank values count as unset.
# Gapless addresses below are the public Monad canary deploy (deployments/143.json, deploy block 111101834,
# BTC perp 1 listed at 111105424); per-process reference: DEPLOYMENT_143.md.
# Never commit secrets. MONAD_HTTP_URLS, MONAD_WS_URL, RELAY_INTERNAL_TOKEN, RELAY_KEY, KEEPER_KEY and ENVIO_API_TOKEN
# come from the host secret store only; leave them blank here.

# Shared by every process
NODE_ENV=production
LOG_LEVEL=info
# Relay and keeper. Monad reverts only value spend below 10 MON, so only value sends (the drip) wait for
# the emptying-tx window. true spaces every send below 10 MON (use only if the canary check fails).
STRICT_RESERVE_SPACING=false
# Ordered, private endpoints first; the public rpc3 is appended as last resort. Keys live in the path.
# Keeper: the first entry must be a private endpoint near the keeper host (SE2-H1: a close walk needs each attempt to
# land within 10 blocks of the previous; a public endpoint at 1 to 2 s per call cannot do that).
MONAD_HTTP_URLS=
MONAD_WS_URL=

# Relay (src/relay/index.ts)
APP_ORIGIN=https://app.example.com
HOST=127.0.0.1
PORT=3700
WS_PORT=3701
# Exact proxy hops only (no /0, nothing wider than /8 or /32).
TRUST_PROXY=
DB_PATH=data/relay.sqlite
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz/ws/v1/market-data
PERPL_MARKET_IDS=1,10
GAP_INDEX_DIR=data/gap-index
JOBS_DB_PATH=data/jobs.sqlite
# Shared secret with the keeper (openssl rand -hex 32): reserved /ws/market pool, detailed /healthz,
# /sigma-refresh forwarding. Same value in the keeper.
RELAY_INTERNAL_TOKEN=
# Sponsor routes (/sponsor/create, /activate). Off unless true; true requires RELAY_KEY and the factory.
SPONSOR_ENABLED=false
# Relay signing key, 0x + 64 hex. Holds only the daily budget. Must differ from KEEPER_KEY (checked when both are
# in one environment). Every process deletes its keys and tokens from the process environment after loading.
RELAY_KEY=
# GaplessFactory from the canary deploy (no default; never hardcoded in src/).
GAPLESS_FACTORY_ADDRESS=0xB1a255e9D4CEdC20998ddC67a7Ec5e0B71bd8777
# Global daily MON for the relay key, gas plus drips (1 MON).
RELAY_DAILY_SPEND_CAP_WEI=1000000000000000000
# Drip to the onchain operator of an activated account (0.5 MON); 0 disables.
DRIP_WEI=500000000000000000
# Operator keys allowed to receive the drip, comma separated. Empty means no drips.
DRIP_ALLOWLIST=
DAILY_CREATE_CAP=6
TOTAL_CREATE_CAP=6
CREATES_PER_IP_PER_DAY=5
ACTIVATIONS_PER_IP_PER_DAY=10
# Global /activate claims per UTC day. Only accounts this relay created are activated.
DAILY_ACTIVATION_CAP=6
# Sponsor only these owners (plus the demo owner). On by default for the canary; with SPONSOR_ENABLED it
# needs SPONSOR_DEMO_OWNER or SPONSOR_OWNER_ALLOWLIST. Every sponsored owner must first send the Perpl
# minimum (10 AUSD) to its predicted account address.
SPONSOR_ALLOWLIST_ONLY=true
# Owner EOAs, comma separated (max 50).
SPONSOR_OWNER_ALLOWLIST=
# Demo owner EOA: always sponsorable, one create slot reserved outside TOTAL_CREATE_CAP and DAILY_CREATE_CAP.
SPONSOR_DEMO_OWNER=
# Keeper internal endpoint on the private network (https, or http only for localhost or *.internal).
# Requires RELAY_INTERNAL_TOKEN and GAPLESS_FACTORY_ADDRESS (callers must be Gapless accounts with a position).
# Also the source of the public GET /api/keeper/console (keeper GET /console, read-only); unset answers 503.
KEEPER_INTERNAL_URL=
# Accepted /sigma-refresh forwards per Gapless account per UTC day. With SPONSOR_ALLOWLIST_ONLY=true only accounts
# this relay created may ask (SE3-M3): the keeper posts at most 12 times per UTC day for everyone, so raise that cap
# (SIGMA_POLICY.maxPostsPerDay) and the keeper budget before quotes are public.
SIGMA_REFRESH_PER_ACCOUNT_PER_DAY=6
# Operator grants the relay sponsors (SA2 N-03 go-condition; CANARY_PARAMS.md). The owner signs all four grant
# fields; a grant outside these is 400 GRANT_OUT_OF_POLICY. Per trade must not exceed per day. Amounts in CNS (6 dp).
# Canary: 25 AUSD per trade (covers the 22-lot demo), 100 AUSD per rolling day, expiry at most 6 h ahead (min 10 min).
SPONSOR_GRANT_MAX_PER_TRADE_CNS=25000000
SPONSOR_GRANT_MAX_PER_DAY_CNS=100000000
SPONSOR_GRANT_MAX_TTL_S=21600

# Keeper (src/keeper/index.ts). MONAD_HTTP_URLS (at least one) and MONAD_WS_URL are required.
# Keeper signing key, 0x + 64 hex. Holds SIGMA_ROLE; also the CRE broadcast key, used only while the keeper is stopped.
# Canary funding (KEEPER_FUNDING_MON): 5.1 MON at the start of each demo day, refilled at every UTC midnight while covers
# are live. The worst day (two 32-lot closes, 2 expires, 12 sigma posts, the arm_repeat cap) settles 3.79 MON at 110 gwei.
KEEPER_KEY=
# Canary keeper signer 0xC0C1EEe02794005eC4ba9ac20A818da42c97a219 (deployments/143.json roles.keeper, holds SIGMA_ROLE):
# KEEPER_KEY must derive to it.
# CoverManager from the canary deploy (no default; the keeper refuses to start without it).
COVER_MANAGER_ADDRESS=0xb07C20cb5328d5208A1453521b94beeB3Faa1771
# Relay fan-out (wss, or ws only for localhost or *.internal).
RELAY_WS_URL=ws://relay.internal:3701/ws/market
# RELAY_INTERNAL_TOKEN must match the relay value (listed above).
LISTED_PERPS=1
KEEPER_DB_PATH=data/keeper.sqlite
KEEPER_HOST=127.0.0.1
KEEPER_PORT=3702
# Hard daily MON cap for every keeper send (required to start). Canary: 4.6 MON with 5.1 MON funding: two worst-case
# closes of a 32-lot cover (the canary maximum: arm, 5 steps at 1.1M, 4 fills at 2.2M, observe, finalize, 1.730 MON
# each at 110 gwei) plus 2 expires, 12 sigma posts and the arm_repeat cap, with one fill call (0.488) always left
# and room for one 3.5M retry.
# Math in CLAUDE.md (keeper budget table). The keeper refuses to arm or trigger a market listed above maxMatchesClose 8.
KEEPER_DAILY_SPEND_CAP_WEI=4600000000000000000
# Part of the cap only hot-path sends may use (paying closes including a walk's final close, remainder fills, the
# first arm per cover per day, observe); non-exempt spend alone stays under cap minus this. Default 2.65 MON: the exempt
# part of two worst-case 32-lot closes at 110 gwei (2.094 settled, 0.242 in flight) plus one 3.5M retry (0.289, SA4-01).
KEEPER_HOTPATH_RESERVE_WEI=2650000000000000000
# Global backstop for trigger_zero (close-floor steps at GAS.triggerStep 1.1M, zero-gap closes). Each touch is admitted
# only with room and balance for its whole walk and fills plus the rest of every walk already running, at most two walk
# starts per cover per UTC day. Unset: min(1.4 MON, cap minus hot reserve) = two walks (10 x 0.1232 at 110 gwei) plus
# one step in flight. If keeper.step_gas_low fires (steps fall back to 2.2M), one walk needs 1.34 here at the 100 gwei
# floor and does not fit above about 104 gwei.
KEEPER_ZERO_PAID_CAP_WEI=
# Daily wei for repeat arms of one cover (arm TTL lapse in chop), outside the hot reserve (SE3-L1). About 5 re-arms.
KEEPER_ARM_REPEAT_CAP_WEI=200000000000000000
# Error log at this daily spend; default 80% of the cap (3.68 MON: a worst-case day reaches it).
KEEPER_SPEND_ALERT_WEI=
# Low-balance alert and degraded /healthz (2 MON): below it one more worst-case close (1.730 at 110 gwei) plus a fill in
# flight (0.242) may not fit, and the next walk is refused at admission (keeper.touch_unfunded). Refill.
KEEPER_LOW_BALANCE_WEI=2000000000000000000
# monadNewHeads on Monad; newHeads only for a plain local node.
KEEPER_HEADS=monadNewHeads
# eth_getLogs range per request for the sigma mark history (public rpc3 allows 100).
KEEPER_LOG_CHUNK_BLOCKS=1000

# Jobs (src/jobs/index.ts)
# HyperSync rejects tokenless queries with 401.
ENVIO_API_TOKEN=
HYPERSYNC_URL=https://monad.hypersync.xyz
OUT_DIR=data/gap-index
JOBS_DB_PATH=data/jobs.sqlite
JOBS_WINDOW_DAYS=7
JOBS_INTERVAL_MS=300000
# Premium curve notional in whole AUSD (canary maxCoverNotionalCNS 20 AUSD).
JOBS_CURVE_NOTIONAL_AUSD=20
# W4a: ingest Perpl native stops (HyperSync JoinAll on the two trigger topics) and write native-stops.json.
JOBS_NATIVE_STOPS=true
# W4b: Gapless contracts for stats.json (GET /api/stats). Once any is set, COVER_MANAGER_ADDRESS and GAPLESS_START_BLOCK
# are both required. Values from deployments/143.json (contracts.* and deployBlock, the CoverVault creation block, the
# first Gapless contract); never guess. Vault and factory feed LP and account counts, the sink feeds CRE report counts.
COVER_MANAGER_ADDRESS=0xb07C20cb5328d5208A1453521b94beeB3Faa1771
COVER_VAULT_ADDRESS=0xab3CB7b3b28366eD7f6C59DbD2D708890919B289
GAPLESS_FACTORY_ADDRESS=0xB1a255e9D4CEdC20998ddC67a7Ec5e0B71bd8777
GAPLESS_CRE_SINK_ADDRESS=0xB9908Df02187c49cc77905e62bCA73AB28d9FD1B
GAPLESS_START_BLOCK=111101834
